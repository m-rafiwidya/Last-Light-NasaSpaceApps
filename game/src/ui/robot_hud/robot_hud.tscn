[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/robot_hud/robot_hud.gd" id="1_rhud"]
[ext_resource type="Theme" uid="uid://ct7oxof1hdkeo" path="res://res/theme.tres" id="2_theme"]
