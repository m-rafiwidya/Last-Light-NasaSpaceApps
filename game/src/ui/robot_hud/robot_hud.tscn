[node name="RobotHUD" type="CanvasLayer"]
script = ExtResource("1_rhud")

[node name="CanvasModulate" type="CanvasModulate" parent="."]

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="CenterContainer" type="CenterContainer" parent="MarginContainer"]
layout_mode = 2
mouse_filter = 2

[node name="Crosshair" type="TextureRect" parent="MarginContainer/CenterContainer"]
unique_name_in_owner = true
layout_mode = 2
texture = ExtResource("3_cross")

[node name="InteractCrosshair" type="TextureRect" parent="MarginContainer/CenterContainer"]
unique_name_in_owner = true
layout_mode = 2
texture = ExtResource("4_interact")

[node name="FrictionCircles" type="Control" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 0
mouse_filter = 2
custom_minimum_size = Vector2(288, 330)
script = ExtResource("5_fric")

[node name="Speed" type="Label" parent="MarginContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 8
theme_override_font_sizes/font_size = 32
text = "SPEED  --"

[node name="Hint" type="Label" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 8
theme_override_font_sizes/font_size = 24
text = "WASD: drive   Mouse: look   E: pick up / drop   LMB: throw   Esc: exit robot"
