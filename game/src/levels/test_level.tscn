[sub_resource type="GDScript" id="GDScript_sj6ii"]
script/source = "extends StaticBody3D

@export var dialog_sequence: DialogSequence

#func _ready() -> void:
	#$InteractTrigger.interacted.connect(_on_interact_trigger_interacted)


func _on_interact_trigger_interacted(_player: Player):
	DialogServer.play_dialog_sequence(dialog_sequence)
"

